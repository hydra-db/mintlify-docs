      "boundElements": null,
      "updated": 1753300000000,
      "link": null,
      "locked": false,
      "text": "Scope:         per-user, via collection\nMutability:   dynamic \u2014 evolves with\n                    every interaction\nQuery via:    type: \"memory\"\nStatus field: vectorstore_status.memories",
