      "type": "retrieval-lab",
      "kind": "knowledge_base",
      "provider": "retrieval-lab",
      "external_id": "rql-v1:contractor-access-window",
      "fields": {
        "kind": "knowledge_base",
        "title": "Temporary contractor access window",
        "body": "Short-lived credentials issued to contractors automatically become invalid fourteen hours after issuance. A sponsor must approve a fresh grant instead of extending the old credential."
      },
      "additional_metadata": {
        "fixture": "hydradb-retrieval-quality-v1",
        "topic": "access-control",
        "synthetic": true
      }
    },
    {
      "id": "rql-v1-cobalt-alert-owner",
      "title": "Cobalt alert ownership",
      "type": "retrieval-lab",
      "kind": "knowledge_base",
      "provider": "retrieval-lab",
      "external_id": "rql-v1:cobalt-alert-owner",
      "fields": {
        "kind": "knowledge_base",
        "title": "Cobalt alert ownership",
        "body": "On the blue-coded severity scale, cobalt ranks above indigo. When a cobalt-severity alert fires, the Tern reliability crew becomes the incident owner. Tern coordinates containment and remains accountable until service health is restored."
      },
      "additional_metadata": {
        "fixture": "hydradb-retrieval-quality-v1",
        "topic": "incident-response",
        "synthetic": true
      }
    },
    {
      "id": "rql-v1-cobalt-recovery-record",
      "title": "Cobalt recovery record location",
      "type": "retrieval-lab",
      "kind": "knowledge_base",
      "provider": "retrieval-lab",
      "external_id": "rql-v1:cobalt-recovery-record",
      "fields": {
        "kind": "knowledge_base",
        "title": "Cobalt recovery record location",
        "body": "After a cobalt-severity alert is resolved, its recovery record must be filed in the Marigold ledger within one business day. The record contains the timeline and corrective actions."
      },
      "additional_metadata": {
        "fixture": "hydradb-retrieval-quality-v1",
        "topic": "incident-records",
        "synthetic": true
      }
    },
    {
      "id": "rql-v1-indigo-alert-owner",
      "title": "Indigo alert ownership",
      "type": "retrieval-lab",
      "kind": "knowledge_base",
      "provider": "retrieval-lab",
      "external_id": "rql-v1:indigo-alert-owner",
      "fields": {
        "kind": "knowledge_base",
        "title": "Indigo alert ownership",
        "body": "An indigo-severity alert is owned by the Wren application team. Wren records the outcome in the Glacier archive after the alert is closed."
      },
      "additional_metadata": {
        "fixture": "hydradb-retrieval-quality-v1",
        "topic": "incident-response",
        "synthetic": true
      }
    },
    {
