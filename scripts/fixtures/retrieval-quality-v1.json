      "title": "Finch staging verification marker",
      "type": "retrieval-lab",
      "kind": "knowledge_base",
      "provider": "retrieval-lab",
      "external_id": "rql-v1:finch-staging-marker",
      "fields": {
        "kind": "knowledge_base",
        "title": "Finch staging verification marker",
        "body": "For every Finch staging release, the operator must quote the exact verification marker EMBER-742 in the handoff note. This marker applies only to the staging environment."
      },
      "additional_metadata": {
        "fixture": "hydradb-retrieval-quality-v1",
        "topic": "release-verification",
        "synthetic": true
      }
    },
    {
