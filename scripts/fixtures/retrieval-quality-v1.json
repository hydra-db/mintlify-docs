      "type": "retrieval-lab",
      "kind": "knowledge_base",
      "provider": "retrieval-lab",
      "external_id": "rql-v1:employee-key-rotation",
      "fields": {
        "kind": "knowledge_base",
        "title": "Employee key rotation",
        "body": "Long-lived employee signing keys rotate once per quarter. This schedule does not apply to contractor access grants or other temporary credentials."
      },
      "additional_metadata": {
        "fixture": "hydradb-retrieval-quality-v1",
